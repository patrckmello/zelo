# Copie para backend/.env e preencha. O arquivo .env é ignorado pelo Git:
# nunca versione chaves, senhas ou segredos.

ZELO_ENV=development

# Senha do PostgreSQL local criado pelo Docker Compose (escolha uma sua).
ZELO_DB_PASSWORD=

# Conexão usada fora do Docker (uvicorn local). No Compose, a URL é montada
# automaticamente com o serviço "db" e a senha acima.
ZELO_DB_PORT=5433
ZELO_DATABASE_URL=postgresql+psycopg://zelo:SUA_SENHA_LOCAL@localhost:5433/zelo

# Segredo de assinatura dos tokens (32+ caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ZELO_JWT_SECRET=

ZELO_ACCESS_TOKEN_MINUTES=15
ZELO_REFRESH_TOKEN_DAYS=30
ZELO_PASSWORD_RESET_MINUTES=30

# Origens permitidas para o app Web em desenvolvimento (localhost em qualquer porta).
ZELO_CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1)(:\d+)?$

# Caixa de saída local dos códigos de recuperação de senha (somente desenvolvimento).
ZELO_PASSWORD_RESET_OUTBOX_DIR=.outbox

# Conta de demonstração criada por "python -m scripts.seed_demo".
ZELO_DEMO_EMAIL=demo@zelo.app
ZELO_DEMO_PASSWORD=

# API EcoMed: a chave fica SOMENTE aqui, no backend.
ECOMED_API_KEY=
ECOMED_BASE_URL=https://ecomed.eco.br/api/public/v1
ECOMED_TIMEOUT_SECONDS=8
ECOMED_CACHE_TTL_SECONDS=300
ECOMED_RATE_LIMIT_PER_MINUTE=60
