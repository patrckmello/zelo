<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/zelo_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_image</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:postSplashScreenTheme">@style/NormalTheme</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/zelo_splash_background</item>
    </style>
</resources>
